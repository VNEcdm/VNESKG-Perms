local Players = game:GetService("Players")

local idsPermitidos = {
	[11380227369] = true,
	[8710384814] = true
}

local function verificarJogador(player)
	if not idsPermitidos[player.UserId] then
		player:Kick("Você não tem permissão para entrar usar o script.")
	end
end

-- Verifica quem entrar depois que o script iniciar
Players.PlayerAdded:Connect(verificarJogador)

-- Verifica jogadores que já estejam no servidor
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(verificarJogador, player)
end
